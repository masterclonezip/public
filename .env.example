# ============================================================================
# 1. SITE IDENTITY, DOMAIN & CANONICAL NON-WWW CONFIGURATION
# ============================================================================
# [BOTH: Admin & Public] [PUBLIC / PLAINTEXT]
# Master Clone Domain Architecture:
# - Leave PUBLIC_DOMAIN & VITE_PUBLIC_DOMAIN empty ("") for automatic host detection,
#   OR specify your clean non-www production domain (e.g., "https://example.com").
# - The system automatically strips any "www.", "admin.", or "masterworld." prefixes
#   to guarantee consistent non-www canonical URLs across all Sitemaps, OpenGraph,
#   Twitter Cards, and JSON-LD schemas.
# - Pair with Cloudflare Single Redirect Rule (see CLOUDFLARE_OPTIMIZATION_GUIDE.md).
PUBLIC_DOMAIN=""
VITE_PUBLIC_DOMAIN=""

# [BOTH: Admin & Public] [PUBLIC / PLAINTEXT]
# Comma-separated list of permitted hostnames for host-header validation & security gateways.
# Example: "example.com,www.example.com,localhost"
ALLOWED_HOSTNAMES=""

# Site Branding & Support Email (Optional fallback; Admin Panel -> Settings takes priority)
VITE_SITE_NAME=""
VITE_SUPPORT_EMAIL=""
APP_URL=""

# [BOTH: Admin & Public] [PUBLIC / PLAINTEXT]
# Optional fallback Logo & Favicon URLs (Cloudinary or direct PNG/WebP URL).
# If set in Admin Panel -> Settings, the Admin Panel URL takes priority.
# Automatically generates 16x16, 32x32, 48x48, 96x96, 144x144, 180x180, 192x192, 512x512, 120px & 1200x630!
VITE_SITE_LOGO_URL=""
SITE_LOGO_URL=""
VITE_SITE_FAVICON_URL=""
SITE_FAVICON_URL=""

# [ADMIN SERVER ONLY] [PUBLIC / PLAINTEXT]
# Secret URL path segment for the Admin Portal (defaults to "masterworld" -> /masterworld/login)
VITE_ADMIN_PATH="masterworld"

# ============================================================================
# 2. DATABASE A: MASTER CATALOG FIREBASE (ADMIN SERVER ONLY)
# (Public Website uses staticData.json & NEVER connects to Database A)
# ============================================================================
# [ADMIN SERVER ONLY] [PUBLIC / PLAINTEXT - Client SDK identifiers]
VITE_FIREBASE_PROJECT_ID=""
VITE_FIREBASE_API_KEY=""
VITE_FIREBASE_AUTH_DOMAIN=""
VITE_FIREBASE_STORAGE_BUCKET=""
VITE_FIREBASE_MESSAGING_SENDER_ID=""
VITE_FIREBASE_APP_ID=""
VITE_FIREBASE_MEASUREMENT_ID=""
VITE_FIREBASE_DATABASE_ID="(default)"

# [ADMIN SERVER ONLY] [PRIVATE / SECRET - Server-only JSON key]
FIREBASE_SERVICE_ACCOUNT=""
FIREBASE_SERVICE_ACCOUNT_KEY=""

# ============================================================================
# 3. DATABASE B: COMMUNITY REVIEWS & REPORTS FIREBASE (BOTH: ADMIN & PUBLIC)
# (Powers live user reviews, star ratings, helpful votes & abuse reports)
# ============================================================================
# [BOTH: Admin & Public] [PUBLIC / PLAINTEXT - Client SDK identifiers]
VITE_COMMUNITY_FIREBASE_PROJECT_ID=""
VITE_COMMUNITY_FIREBASE_API_KEY=""
VITE_COMMUNITY_FIREBASE_AUTH_DOMAIN=""
VITE_COMMUNITY_FIREBASE_STORAGE_BUCKET=""
VITE_COMMUNITY_FIREBASE_MESSAGING_SENDER_ID=""
VITE_COMMUNITY_FIREBASE_APP_ID=""
VITE_COMMUNITY_FIREBASE_MEASUREMENT_ID=""
VITE_COMMUNITY_FIREBASE_DATABASE_ID="(default)"

# [BOTH: Admin & Public] [PRIVATE / SECRET - Server-only JSON key]
COMMUNITY_FIREBASE_SERVICE_ACCOUNT=""
COMMUNITY_FIREBASE_SERVICE_ACCOUNT_KEY=""

# ============================================================================
# 4. ADMIN SECURITY, JWT, 2FA & VAULT CRYPTOGRAPHY
# ============================================================================
# [ADMIN SERVER ONLY] [PRIVATE / SECRET - Never add to Public Server]
ADMIN_EMAIL=""
ADMIN_PASSWORD=""
ADMIN_PASSWORD_HASH=""
ADMIN_JWT_SECRET=""
ADMIN_SESSION_SECRET=""
ADMIN_TOTP_SECRET=""
VITE_ADMIN_EMAIL=""
GEMINI_API_KEY=""

# [BOTH: Admin & Public] [PRIVATE / SECRET - Must match on Admin & Public!]
# Used by Admin to encrypt download links and by Public /moreinfo API to decrypt in RAM
AES_KEY=""
VAULT_SECRET_KEY=""
VITE_VAULT_SECRET_KEY=""

# [PUBLIC SERVER (& Admin if testing /moreinfo)] [PRIVATE / SECRET]
NONCE_HMAC_SECRET=""
GATE_SIGNING_SECRET=""
DID_HMAC_SECRET=""
IP_HASH_SALT=""
CRON_SECRET=""

# ============================================================================
# 5. CLOUDFLARE TURNSTILE & UPSTASH REDIS (/moreinfo Gateway & Anti-Bot Protection)
# Complete Setup Guide: See CLOUDFLARE_OPTIMIZATION_GUIDE.md
# ============================================================================
# [BOTH: Admin & Public] [PUBLIC / PLAINTEXT - Widget Site Key]
# Get from Cloudflare Dashboard -> Turnstile -> Add Site (Free, unlimited CAPTCHA alternative).
# Primary: VITE_TURNSTILE_SITE_KEY (also supports TURNSTILE_SITE_KEY, CF_TURNSTILE_SITE_KEY)
VITE_TURNSTILE_SITE_KEY=""
TURNSTILE_SITE_KEY=""

# [BOTH: Admin & Public] [PRIVATE / SECRET - Server Verification Key]
# Primary: TURNSTILE_SECRET_KEY (also supports VITE_TURNSTILE_SECRET_KEY, TURNSTILE_TOKEN)
TURNSTILE_SECRET_KEY=""

# [OPTIONAL: ADMIN SERVER ONLY] [PRIVATE / SECRET]
# Cloudflare Zone ID & API Token for automated Edge Cache Purging on catalog update.
# Find Zone ID in Cloudflare Dashboard -> Overview -> API -> Zone ID.
# Generate API Token with "Cache Purge" permission under My Profile -> API Tokens.
CLOUDFLARE_ZONE_ID=""
CLOUDFLARE_API_TOKEN=""

# [PUBLIC SERVER (& Admin if testing /moreinfo)] [PRIVATE / SECRET]
# Distributed Upstash Redis for multi-region edge rate limiting & nonce burning.
# Get free REST credentials from https://console.upstash.com/
UPSTASH_REDIS_REST_URL=""
UPSTASH_REDIS_REST_TOKEN=""

# ============================================================================
# 6. CLOUDINARY & IMAGE CDN (ADMIN SERVER ONLY)
# (Public Website optimizes Cloudinary URLs automatically via URL transforms)
# ============================================================================
# [ADMIN SERVER ONLY] [PUBLIC / PLAINTEXT]
CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_CLOUD_NAME=""
VITE_CLOUDINARY_UPLOAD_PRESET="uploads"
CLOUDINARY_UPLOAD_FOLDER="uploads"

# [ADMIN SERVER ONLY] [PRIVATE / SECRET]
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# ============================================================================
# 7. GITHUB DUAL-REPO SPLIT-SYNC AUTOMATION (ADMIN SERVER ONLY)
# ============================================================================
# [ADMIN SERVER ONLY] [PRIVATE / SECRET]
GITHUB_TOKEN=""
GITHUB_PAT=""

# [ADMIN SERVER ONLY] [PUBLIC / PLAINTEXT]
GITHUB_OWNER=""
VITE_GITHUB_OWNER=""
GITHUB_PUBLIC_REPO=""
VITE_GITHUB_PUBLIC_REPO=""
GITHUB_ADMIN_REPO=""
VITE_GITHUB_ADMIN_REPO=""
GITHUB_BRANCH="main"

